[Unit]
Description=dsh-nas restricted upgrade request processor
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ConditionPathIsDirectory=/opt/dsh-nas
WorkingDirectory=/opt/dsh-nas
ExecStartPre=/usr/bin/test -x /opt/dsh-nas/tools/process-upgrade-request.sh
ExecStart=/opt/dsh-nas/tools/process-upgrade-request.sh
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
# deploy.sh 需要在固定 /opt/dsh-nas 内更新版本和 .env；因此不能把项目树设为只读。
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/dsh-nas
ReadWritePaths=/var/lib/dsh-nas-upgrade
# 此服务通过宿主机 Docker CLI/Compose 执行固定项目升级；不要向 dsh 容器暴露 Docker socket。
